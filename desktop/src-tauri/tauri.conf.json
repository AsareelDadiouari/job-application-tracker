{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Job Application Tracker",
  "version": "0.1.0",
  "identifier": "com.asareeldadiouari.jobtracker",
  "build": {
    "frontendDist": "../../client/dist/client/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ../client start",
    "beforeBuildCommand": "npm --prefix ../client run build"
  },
  "app": {
    "windows": [
      {
        "title": "Job Application Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5223 https://api.example.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
